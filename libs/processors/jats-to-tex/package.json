{
  "name": "processors-jats-to-tex",
  "version": "0.0.0",
  "private": true,
  "description": "jatsToTex(jats: string): Promise<VFile>;",
  "type": "module",
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },

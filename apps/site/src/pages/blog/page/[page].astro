---
import type { GetStaticPaths } from "astro";
import BlogList from "~/layouts/BlogList.astro";
import { site } from "~/lib/settings";
import { getPosts } from "~/lib/sources/blog";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	const total = Math.ceil(posts.length / site.blog.postsPerPage);
	return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}) satisfies GetStaticPaths;

const current = Number(Astro.params.page);
const posts = await getPosts();
const perPage = site.blog.postsPerPage;
---

<BlogList
	title={site.blog.title}
	kicker={`Page ${current}`}
	posts={posts.slice((current - 1) * perPage, current * perPage)}
	page={{ current, total: Math.ceil(posts.length / perPage), href: (n) => (n === 1 ? "/blog" : `/blog/page/${n}`) }}
/>

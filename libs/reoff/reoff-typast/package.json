{
  "name": "reoff-typast",
  "version": "0.0.0",
  "description": "reoff plugin to transform Word (ooxast) to Typst (typast).",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/reoff/reoff-typast"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/reoff/reoff-typast#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "reoff",
    "docx",
    "word",
    "typst",
    "typast",
    "plugin"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "reoff-typast",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/xast": "catalog:",
    "ooxast": "workspace:^",
    "ooxast-util-to-typast": "workspace:^",
    "typast": "workspace:^",
    "unified": "catalog:"
  },
  "devDependencies": {
    "docx-to-vfile": "workspace:^",
    "reoff-parse": "workspace:^",
    "typast-stringify": "workspace:^"
  }
}

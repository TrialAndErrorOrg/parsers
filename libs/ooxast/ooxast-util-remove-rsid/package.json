{
  "name": "ooxast-util-remove-rsid",
  "version": "0.5.0",
  "description": "Cleans all the rsid tags from an ooxast tree, and merges `w:r` elements if they only differ by rsid values.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/ooxast/ooxast-util-remove-rsid"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/ooxast/ooxast-util-remove-rsid#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "ooxast",
    "reoff",
    "word",
    "docx",
    "office",
    "syntax",
    "tree",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ooxast-util-remove-rsid",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "ooxast": "workspace:^",
    "ooxast-util-get-style": "workspace:^",
    "unist-util-remove": "catalog:",
    "unist-util-visit": "catalog:",
    "xast-util-is-element": "workspace:^",
    "xast-util-select": "workspace:^"
  }
}

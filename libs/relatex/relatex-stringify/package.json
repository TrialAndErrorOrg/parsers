{
  "name": "relatex-stringify",
  "version": "0.0.1",
  "description": "Plugin for `relatex` that stringifies a `texast` syntax tree to a LaTeX file.",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "latex",
    "relatex",
    "tree",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "relatex-stringify",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "texast": "workspace:^",
    "texast-util-to-latex": "workspace:^",
    "unified": "^10.1.2"
  }
}

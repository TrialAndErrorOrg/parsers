---
import Page from "~/layouts/Page.astro";
import { canPreview } from "~/lib/preview";
import { getCmsDraft } from "~/lib/sources/pages";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

if (!canPreview(Astro.cookies)) {
	return new Response("Open this preview from Strapi", { status: 401 });
}

const page = await getCmsDraft(Astro.params.slug!);
if (!page) return new Response("Draft not found", { status: 404 });
---

<Page title={page.title} description={page.description} body={page.body} noindex>
	<div slot="banner" class="border-b-frame border-ink bg-journal px-5 py-2 text-center font-heading font-bold text-paper">
		Draft preview. This is not published yet.
	</div>
</Page>

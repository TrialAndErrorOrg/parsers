{
  "name": "converter",
  "version": "0.0.0",
  "private": true,
  "description": "The JOTE converter: .docx to LaTeX and Typst in the browser, as a React component. The site shows it at /admin/convert",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "node scripts/bundle-typst-template.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "bundle-typst-template": "node scripts/bundle-typst-template.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@zip.js/zip.js": "^2.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx-to-typst": "workspace:^",
    "docx-to-vfile": "workspace:^",
    "lucide-react": "^1.50.0",
    "react-syntax-highlighter": "^16.1.1",
    "reoff-clean": "workspace:^",
    "reoff-markup-to-style": "workspace:^",
    "reoff-parse": "workspace:^",
    "reoff-unified-latex": "workspace:^",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "unified": "catalog:",
    "unified-latex-stringify": "workspace:^",
    "vfile": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.1.0-dev.20261004.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}

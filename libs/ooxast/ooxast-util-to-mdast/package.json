{
  "name": "ooxast-util-to-mdast",
  "version": "0.2.0",
  "description": "Convert `ooxast` syntax tree to `mdast` syntax tree.",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "word",
    "docx",
    "office",
    "jats",
    "reoff",
    "mdast",
    "markdown"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ooxast-util-to-unified-latex",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@benrbray/mdast-util-cite": "^1.1.0",
    "@benrbray/micromark-extension-cite": "^1.0.0",
    "@types/mdast": "^3.0.11",
    "@types/unist": "^2.0.6",
    "@types/xast": "^1.0.2",
    "@unified-latex/unified-latex-builder": "^1.3.1",
    "csl-json": "0.1.0",
    "docx-to-vfile": "workspace:^",
    "extend": "^3.0.2",
    "hast-util-whitespace": "^2.0.1",
    "mdast-builder": "^1.1.1",
    "mdast-util-math": "^2.0.2",
    "mdast-util-phrasing": "^3.0.1",
    "mdast-util-to-string": "^3.2.0",
    "ooxast": "workspace:^",
    "ooxast-util-citations": "workspace:^",
    "rehype-minify-whitespace": "^5.0.0",
    "unist-util-position": "^4.0.4",
    "vfile": "^5.3.7",
    "xast-util-from-xml": "^3.0.0",
    "xast-util-is-element": "workspace:^",
    "xast-util-select": "workspace:^",
    "xast-util-to-string": "^2.0.1"
  },
  "devDependencies": {
    "@benrbray/remark-cite": "^1.1.0",
    "@types/extend": "^3.0.4",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "remark-stringify": "^10.0.3",
    "reoff-cite": "workspace:^",
    "reoff-clean": "workspace:^",
    "reoff-parse": "workspace:^",
    "reoff-parse-references": "workspace:^",
    "unified": "^10.1.2",
    "unist-util-remove-position": "4.0.2",
    "xastscript": "^3.1.1"
  }
}

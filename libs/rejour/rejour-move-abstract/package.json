{
  "name": "rejour-move-abstract",
  "version": "0.0.1",
  "description": "Really simple plugin for `rejour` that moves the abstract from the `body` to the `front` of a `JATS` document.",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "abstract",
    "syntax",
    "tree",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "rejour-move-abstract",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "jast-types": "workspace:^",
    "unist-util-filter": "^4.0.1",
    "unist-util-remove": "^3.1.1",
    "unist-util-visit": "^4.1.2"
  },
  "devDependencies": {
    "ast-stringify": "workspace:^",
    "rejour-parse": "workspace:^",
    "rejour-stringify": "workspace:^",
    "unified": "^10.1.2",
    "unist-util-map": "^3.1.3",
    "vfile-reporter": "^7.0.5"
  }
}

{
  "name": "ooxast-util-citation-plugin",
  "version": "0.3.0",
  "description": "Small ooxast utility which scans the text to identify the citation plugin used, either Mendely, Zotero, EndNote, Citavi, native word citations or none at all.",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "syntax-tree",
    "docx",
    "ooxast",
    "citation"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ooxast-util-citation-plugin",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/unist": "^2.0.6",
    "ooxast": "workspace:^",
    "unist-util-visit": "^4.1.2",
    "xast-util-is-element": "workspace:^",
    "xast-util-to-string": "^2.0.1"
  },
  "devDependencies": {
    "docx-to-vfile": "workspace:^",
    "reoff-parse": "workspace:^",
    "unified": "^10.1.2"
  }
}

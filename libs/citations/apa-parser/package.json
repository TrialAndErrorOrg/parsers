{
  "name": "apa-parser",
  "version": "0.0.1",
  "description": "This package is [ESM only](https://gist.github.com/sindresorhus/a39789f98801d908bbc7ff3ecc99d99c).",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/citations/apa-parser"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/citations/apa-parser#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "abstract",
    "syntax",
    "tree",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "apa-parser",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/nlcst": "catalog:",
    "retext-english": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile-reporter": "catalog:"
  }
}

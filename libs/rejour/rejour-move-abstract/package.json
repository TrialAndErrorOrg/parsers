{
  "name": "rejour-move-abstract",
  "version": "0.0.1",
  "private": true,
  "description": "Really simple plugin for `rejour` that moves the abstract from the `body` to the `front` of a `JATS` document.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/rejour/rejour-move-abstract"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/rejour/rejour-move-abstract#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "abstract",
    "syntax",
    "tree",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "rejour-move-abstract",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "jast-types": "workspace:^",
    "unist-util-filter": "catalog:",
    "unist-util-remove": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "rejour-parse": "workspace:^",
    "rejour-stringify": "workspace:^",
    "unified": "catalog:",
    "unist-util-map": "catalog:",
    "vfile-reporter": "catalog:"
  }
}

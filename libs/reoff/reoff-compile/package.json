{
  "name": "reoff-compile",
  "version": "0.0.1",
  "description": "Compile a reoff-compatible VFile or bare ooxast syntax tree to a .docx document",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/reoff-compile",
  "homepage": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "abstract",
    "syntax",
    "tree",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "reoff-compile",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.6.83",
    "docx-to-vfile": "workspace:^",
    "ooxast": "workspace:^",
    "unified": "^10.1.2",
    "xast-util-to-xml": "^3.0.2"
  },
  "devDependencies": {
    "reoff-markup-to-style": "workspace:^",
    "reoff-parse": "workspace:^",
    "vfile": "^5.3.7"
  }
}

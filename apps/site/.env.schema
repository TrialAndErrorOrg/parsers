# Environment for the website. Read by varlock (https://varlock.dev), which fills the secrets from
# 1Password. Nothing secret is stored here, only references to the Website vault.
#
# Locally, `pnpm dev` and `pnpm build` run through `varlock run`, and the 1Password desktop app
# asks once per session. Without access to the vault, put ONEPASSWORD=false and your own values
# in .env.local (gitignored), which wins over this file.
#
# In CI and where the site runs (Coolify), OP_TOKEN is the only secret: a 1Password service account
# token that can read the Website vault and nothing else. The image starts the server through
# `varlock run`, so it reads its own secrets at start. See docs/deploying.md.
# Astro checks every value again in astro.config.mjs (`env.schema`).
#
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=not($VARLOCK_IS_CI), account=trialanderror)
# @defaultSensitive=true
# @defaultRequired=false
# ---

# 1Password service account token, for CI. Locally the desktop app is used instead.
# @type=opServiceAccountToken
OP_TOKEN=

# Read secrets from 1Password. Set to false in .env.local to use your own values instead.
# @sensitive=false @type=boolean
ONEPASSWORD=true

# Where site-content is checked out, relative to apps/site. Defaults to ../../../site-content, next
# to this repository (src/integrations/content.ts).
# @sensitive=false
CONTENT_DIR=

# --- Build: where blog posts, authors, team and journal articles come from ---

# @sensitive=false
STRAPI_URL=https://cms.trialanderror.org
# Read-only Strapi API token. Needed for drafts, optional for published content.
STRAPI_TOKEN=if($ONEPASSWORD, op("op://Website/Strapi TrialAndError CI Read Token/credential"))

# @sensitive=false
UNDERLAY_URL=https://www.underlay.org
# Without it Underlay reads are anonymous and rate limited to 60 requests a minute.
UNDERLAY_TOKEN=if($ONEPASSWORD, op("op://Website/Underlay/credential"))

# strapi or underlay. With underlay the blog is read from UNDERLAY_BLOG_COLLECTION, filled by
# scripts/blog-to-underlay.ts.
# @sensitive=false @type=enum(strapi, underlay)
BLOG_SOURCE=strapi
# @sensitive=false
UNDERLAY_BLOG_COLLECTION=centeroftrialanderror/blog

# --- Runtime: what the server needs where the site runs ---

# Shared secret for Strapi draft previews. Must equal DRAFT_SECRET in Strapi.
DRAFT_SECRET=

# How editors sign in to /admin: github (their own GitHub account), microsoft (Entra, no GitHub
# account needed) or dev (a test editor, pnpm dev only). See docs/admin-sign-in.md. The sign-in
# secrets below are only read with microsoft.
# @sensitive=false @type=enum(github, microsoft, dev)
ADMIN_AUTH=github
# @sensitive=false @type=boolean
ADMIN_READ_ONLY=false

ADMIN_SESSION_SECRET=if(and($ONEPASSWORD, eq($ADMIN_AUTH, microsoft)), op("op://Website/trialanderror admin Entra app/session secret"))
# @sensitive=false
ENTRA_TENANT_ID=if(and($ONEPASSWORD, eq($ADMIN_AUTH, microsoft)), op("op://Website/trialanderror admin Entra app/tenant id"))
# @sensitive=false
ENTRA_CLIENT_ID=if(and($ONEPASSWORD, eq($ADMIN_AUTH, microsoft)), op("op://Website/trialanderror admin Entra app/username"))
ENTRA_CLIENT_SECRET=if(and($ONEPASSWORD, eq($ADMIN_AUTH, microsoft)), op("op://Website/trialanderror admin Entra app/credential"))
# @sensitive=false
GITHUB_APP_ID=if(and($ONEPASSWORD, eq($ADMIN_AUTH, microsoft)), op("op://Website/Admin CMS Write Github App/username"))
GITHUB_APP_PRIVATE_KEY=if(and($ONEPASSWORD, eq($ADMIN_AUTH, microsoft)), op("op://Website/Admin CMS Write Github App/credential"))
# Local testing only: a token that stands in for the GitHub App, e.g. $(gh auth token)
GITHUB_CONTENT_TOKEN=

# --- CI only: telling Coolify to deploy the new image ---

# The app's deploy webhook (Coolify, the app, Webhooks). Deploying is skipped while it's empty.
# @sensitive=false
COOLIFY_DEPLOY_URL=https://app.coolify.io/api/v1/deploy?uuid=avytsqsicyojwuklygs7jiyw&force=false
# A Coolify API token with deploy rights
COOLIFY_TOKEN=if(and($VARLOCK_IS_CI, not(isEmpty($COOLIFY_DEPLOY_URL))), op("op://Website/Coolify Website Deploy Token/credential"))

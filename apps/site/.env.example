# Where blog posts, authors, team and pages come from
STRAPI_URL=https://cms.trialanderror.org
# A read-only Strapi API token. Needed for drafts, optional for published content.
STRAPI_TOKEN=
# Shared secret for draft previews. Must equal DRAFT_SECRET in Strapi (its preview button sends it)
DRAFT_SECRET=
# Journal articles (and, later, the blog) come from Underlay
UNDERLAY_URL=https://www.underlay.org
# Optional. Without it Underlay reads are anonymous and rate limited to 60 requests a minute.
UNDERLAY_TOKEN=
# strapi (default) or underlay. With underlay the blog is read from this collection,
# filled by scripts/blog-to-underlay.ts
BLOG_SOURCE=strapi
UNDERLAY_BLOG_COLLECTION=centeroftrialanderror/blog

# How editors sign in to /admin: github (their own GitHub account, the default),
# microsoft (Entra, no GitHub account needed) or dev (a test editor, pnpm dev only).
# See "Microsoft sign-in for /admin" in the README.
ADMIN_AUTH=github
ADMIN_SESSION_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Local testing only: a token that stands in for the GitHub App, and a switch that refuses writes
# GITHUB_CONTENT_TOKEN=
# ADMIN_READ_ONLY=true

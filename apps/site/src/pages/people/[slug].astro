---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import ArticleCard from "~/components/ArticleCard.astro";
import Picture from "~/components/Picture.astro";
import PostCard from "~/components/PostCard.astro";
import SocialIcon from "~/components/SocialIcon.astro";
import Base from "~/layouts/Base.astro";
import { stripHtml } from "~/lib/format";
import { getPeople } from "~/lib/people";

// Other slugs a person had redirect here from /blog/author/<slug>
export const getStaticPaths = (async () =>
	(await getPeople()).map((profile) => ({ params: { slug: profile.slug }, props: { profile } }))) satisfies GetStaticPaths;

const { person, posts, articles } = Astro.props.profile;
const initials = person.name
	.split(" ")
	.map((part) => part[0])
	.slice(0, 2)
	.join("");

const labels: Record<string, string> = {
	bluesky: "Bluesky",
	github: "GitHub",
	linkedin: "LinkedIn",
	mastodon: "Mastodon",
	twitter: "X",
	website: "Website",
};
const links = [
	...(person.orcid ? [{ icon: "orcid", label: "ORCID", url: person.orcid }] : []),
	...person.links.map((l) => ({ ...l, label: labels[l.icon] ?? "Link" })),
	...(person.email ? [{ icon: "email", label: person.email, url: `mailto:${person.email}` }] : []),
];
const description = [person.position, person.summary && stripHtml(person.summary)].filter(Boolean).join(". ").slice(0, 300) || undefined;
---

<Base title={person.name} description={description}>
	<div class="border-b-frame border-ink bg-accent">
		<div class="page grid items-center gap-8 py-12 md:grid-cols-[auto_1fr] md:gap-12 md:py-20">
			<div class="size-48 overflow-hidden border-frame border-ink bg-paper shadow-hard-lg md:size-64">
				{
					person.image ? (
						<Picture image={person.image} width={512} class="size-full object-cover" alt={person.name} eager />
					) : (
						<span class="flex size-full items-center justify-center font-heading text-7xl font-black">{initials}</span>
					)
				}
			</div>
			<div class="flex min-w-0 flex-col gap-4" data-pagefind-body data-pagefind-filter="section:People">
				<p class="label self-start bg-paper">{person.kind === "team" ? "Team" : "Author"}</p>
				<h1 class="font-heading text-5xl leading-none font-black tracking-tighter md:text-8xl" data-pagefind-meta="title">{person.name}</h1>
				{
					(person.position || person.pronouns) && (
						<p class="flex flex-wrap items-baseline gap-x-3 font-heading text-xl font-bold md:text-2xl">
							{person.position}
							{person.pronouns && <span class="text-base font-semibold">({person.pronouns})</span>}
						</p>
					)
				}
				{
					links.length > 0 && (
						<ul class="mt-2 flex flex-wrap gap-3">
							{links.map((l) => (
								<li>
									<a href={l.url} class="button button-plain px-3 py-1 text-base">
										<SocialIcon icon={l.icon} class:list={["size-4", l.icon === "orcid" && "text-orcid"]} />
										{l.label}
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</div>
	</div>

	{
		person.summary && (
			<div class="page pt-12">
				<div class="prose-site" data-pagefind-body set:html={person.summary} />
			</div>
		)
	}

	{
		posts.length > 0 && (
			<section class="page py-12">
				<h2 class="section-title mb-8">Blog posts</h2>
				<div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			</section>
		)
	}

	{
		articles.length > 0 && (
			<section class="page py-12">
				<h2 class="section-title mb-8">Journal articles</h2>
				<div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
					{articles.map((article) => (
						<ArticleCard article={article} />
					))}
				</div>
			</section>
		)
	}

	<div class="page pb-16">
		<a href="/people" class="button button-plain">
			<Icon name="lucide:arrow-left" class="size-5" aria-hidden="true" /> Everyone
		</a>
	</div>
</Base>

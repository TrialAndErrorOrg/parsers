{
  "name": "parse-text-cite",
  "version": "0.3.2",
  "description": "Small tool that parses a string of text containing APA style in text citations, e.g.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/citations/parse-text-cite"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/citations/parse-text-cite#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "citations",
    "apa",
    "references",
    "bibliography",
    "parser"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "parse-text-cite",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "csl-json": "0.1.0",
    "moo": "^0.5.3",
    "nearley": "^2.20.1"
  },
  "devDependencies": {
    "@types/moo": "^0.5.10",
    "@types/nearley": "^2.11.5"
  }
}

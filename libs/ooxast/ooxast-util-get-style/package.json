{
  "name": "ooxast-util-get-style",
  "version": "0.4.1",
  "description": "Get style from a `w:p` or `w:r` element.",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "ooxast",
    "docx",
    "reoff"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ooxast-util-get-style",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "ooxast": "workspace:^",
    "xast-util-is-element": "workspace:^",
    "xast-util-select": "workspace:^"
  }
}

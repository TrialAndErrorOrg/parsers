---
import Base from "~/layouts/Base.astro";
---

<Base title="Page not found" noindex>
	<section class="page flex flex-col items-start gap-8 py-24">
		<p class="label">404</p>
		<h1 class="font-heading text-5xl font-black tracking-tighter md:text-8xl">This page is a failed experiment.</h1>
		<p class="text-xl">We couldn't find what you were looking for. Fitting, for us.</p>
		<div class="flex flex-wrap gap-4">
			<a href="/" class="button">Home</a>
			<a href="/blog" class="button button-plain">Blog</a>
			<a href="/search" class="button button-plain">Search</a>
		</div>
	</section>
</Base>

{
  "name": "@trialanderror/converter-cli",
  "version": "0.2.0",
  "description": "convert books",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/converter-cli",
  "homepage": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "word",
    "cli",
    "latex"
  ],
  "bin": {
    "cote-conv": "./dist/lib/bin/cli.js"
  },
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "@trialanderror/converter-cli",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@unified-latex/unified-latex-builder": "catalog:",
    "@unified-latex/unified-latex-types": "catalog:",
    "chokidar": "^5.0.0",
    "docx-to-vfile": "workspace:^",
    "js-yaml": "^5.4.2",
    "ooxast": "workspace:^",
    "ooxast-util-get-style": "workspace:^",
    "ooxast-util-markup-to-style": "workspace:^",
    "ooxast-util-to-unified-latex": "workspace:^",
    "reoff-cite": "workspace:^",
    "reoff-clean": "workspace:^",
    "reoff-markup-to-style": "workspace:^",
    "reoff-parse": "workspace:^",
    "reoff-parse-references": "workspace:^",
    "reoff-unified-latex": "workspace:^",
    "unified": "catalog:",
    "unified-latex-stringify": "workspace:^",
    "xast-util-to-string": "catalog:",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  }
}

{
  "name": "relatex-add-preamble",
  "version": "0.0.1",
  "description": "Plugin for `relatex` that adds a preamble to a `texast` syntax tree.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/relatex/relatex-add-preamble"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/relatex/relatex-add-preamble#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "abstract",
    "syntax",
    "tree",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "relatex-add-preamble",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "texast": "workspace:^",
    "texast-util-add-preamble": "workspace:^",
    "unified": "catalog:",
    "vfile": "catalog:"
  }
}

{
  "name": "rejour-relatex",
  "version": "0.0.1",
  "description": "Plugin for `rejour` that transforms a `jast` syntax tree into a `texast` syntax tree, allowing for conversion between JATS XML and LaTeX.",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "rejour",
    "relatex",
    "texast",
    "latex",
    "jats",
    "jats-xml"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "rejour-relatex",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "jast-types": "workspace:^",
    "jast-util-to-texast": "workspace:^",
    "texast": "workspace:^",
    "unified": "^10.1.2",
    "vfile": "^5.3.7"
  }
}

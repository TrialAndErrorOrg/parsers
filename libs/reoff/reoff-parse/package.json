{
  "name": "reoff-parse",
  "version": "0.5.0",
  "description": "Plugin for [reoff][reoff] to parse a `.docx` XML file into an `ooxast` AST. ",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "reoff",
    "ooxast",
    "word",
    "docx"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "reoff-parse",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/xast": "^1.0.2",
    "docx-to-vfile": "workspace:^",
    "unified": "^10.1.2",
    "unist-util-filter": "^4.0.1",
    "vfile": "^5.3.7",
    "vfile-message": "^3.1.4",
    "xast-util-from-xml": "^3.0.0"
  },
  "devDependencies": {
    "unist-util-remove-position": "4.0.2"
  }
}

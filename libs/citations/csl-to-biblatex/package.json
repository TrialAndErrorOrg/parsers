{
  "name": "csl-to-biblatex",
  "version": "0.3.1",
  "description": "Somewhat jank CSL-JSON to biblatex converter",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "csl",
    "biblatex",
    "converter",
    "references",
    "csl-json",
    "bibliography"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "csl-to-biblatex",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "csl-json": "0.1.0"
  }
}

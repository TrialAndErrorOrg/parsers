{
  "name": "typast-util-to-typst",
  "version": "0.0.0",
  "description": "Serialize a `typast` (Typst) syntax tree to Typst source, escaping text so it renders literally.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/typast/typast-util-to-typst"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/typast/typast-util-to-typst#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "typast",
    "typst",
    "stringify",
    "serialize",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "typast-util-to-typst",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "typast": "workspace:^"
  }
}

{
  "name": "xast-util-select",
  "version": "0.3.0",
  "description": "Port of `(hast-util-select)[https://github.com/syntax-tree/hast-util-select]` for use with `xast` nodes.",
  "license": "MIT",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "xast",
    "hast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "xast-util-select",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/unist": "^2.0.6",
    "@types/xast": "^1.0.2",
    "bcp-47-match": "^2.0.1",
    "comma-separated-tokens": "^2.0.2",
    "css-selector-parser": "^1.4.1",
    "direction": "^2.0.1",
    "hast-util-whitespace": "^2.0.1",
    "nth-check": "^2.1.1",
    "property-information": "^6.1.1",
    "space-separated-tokens": "^2.0.2",
    "xast-util-has-attribute": "workspace:^",
    "xast-util-is-element": "workspace:^",
    "zwitch": "^2.0.2"
  },
  "devDependencies": {
    "unist-builder": "^3.0.1",
    "xastscript": "^3.1.1"
  }
}

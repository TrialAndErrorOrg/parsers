{
  "name": "unified-latex-util-to-typast",
  "version": "0.0.0",
  "description": "Convert a unified-latex tree (a JOTE LaTeX article) into a typast (Typst) tree for the jote-article Typst template.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/unified-latex/unified-latex-util-to-typast"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/unified-latex/unified-latex-util-to-typast#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "unified-latex",
    "latex",
    "typst",
    "typast",
    "util"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "unified-latex-util-to-typast",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@unified-latex/unified-latex-types": "catalog:",
    "@unified-latex/unified-latex-util-arguments": "catalog:",
    "@unified-latex/unified-latex-util-parse": "catalog:",
    "@unified-latex/unified-latex-util-print-raw": "catalog:",
    "tex2typst": "^0.6.2",
    "typast": "workspace:^",
    "unified": "catalog:",
    "vfile": "catalog:"
  },
  "devDependencies": {
    "typast-util-to-typst": "workspace:^"
  }
}

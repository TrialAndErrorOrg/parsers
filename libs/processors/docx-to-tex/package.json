{
  "name": "docx-to-tex",
  "version": "0.0.0",
  "private": true,
  "description": "DOCX to TeX converter",
  "type": "module",
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "docx-to-tex",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "docx-to-vfile": "workspace:^",
    "rejour-relatex": "workspace:^",
    "relatex-stringify": "workspace:^",
    "reoff-cite": "workspace:^",
    "reoff-clean": "workspace:^",
    "reoff-parse": "workspace:^",
    "reoff-parse-references": "workspace:^",
    "reoff-rejour": "workspace:^",
    "unified": "^10.1.2",
    "vfile": "^5.3.7"
  },
  "devDependencies": {
    "unist-util-remove-position": "4.0.2",
    "xast-util-select": "workspace:^"
  }
}

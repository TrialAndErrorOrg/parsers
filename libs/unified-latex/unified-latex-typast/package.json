{
  "name": "unified-latex-typast",
  "version": "0.0.0",
  "description": "unified plugin to transform a unified-latex (LaTeX) tree into a typast (Typst) tree.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/unified-latex/unified-latex-typast"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/unified-latex/unified-latex-typast#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "unified-latex",
    "latex",
    "typst",
    "typast",
    "plugin"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "unified-latex-typast",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@unified-latex/unified-latex-types": "catalog:",
    "typast": "workspace:^",
    "unified": "catalog:",
    "unified-latex-util-to-typast": "workspace:^"
  },
  "devDependencies": {
    "@unified-latex/unified-latex-util-parse": "catalog:",
    "typast-util-to-typst": "workspace:^",
    "vfile": "catalog:"
  }
}

---
import type { Section } from "~/content.config";
import Markdown from "../Markdown.astro";

type Props = Extract<Section, { type: "hero" }>;
const { title, subtitle, text, buttons } = Astro.props;

// Each line of the title gets its own box, like the old blog header
const lines = title.split("\n").filter(Boolean);
---

<section class="border-b-frame border-ink bg-accent-soft">
	<div class="page grid gap-12 py-16 md:grid-cols-[3fr_2fr] md:items-center md:py-28">
		<h1 class="flex flex-col items-start font-heading text-5xl leading-none font-black tracking-tighter md:text-7xl xl:text-8xl">
			{
				lines.map((line, i) => (
					<span class:list={["border-heavy border-ink bg-accent px-4 pt-3 pb-1 md:px-6", i > 0 && "-mt-[var(--heavy)]", i % 2 === 1 && "ml-6 md:ml-16"]}>
						{line}
					</span>
				))
			}
		</h1>
		<div class="flex flex-col gap-6 border-frame border-ink bg-paper p-6 shadow-hard-lg md:p-8">
			{subtitle && <p class="font-heading text-2xl leading-tight font-bold tracking-tighter md:text-3xl">{subtitle}</p>}
			{text && <Markdown text={text} class="text-lg" />}
			{
				buttons.length > 0 && (
					<div class="flex flex-wrap gap-4">
						{buttons.map((b) => (
							<a href={b.url} class:list={["button", b.style === "plain" && "button-plain"]}>
								{b.label}
							</a>
						))}
					</div>
				)
			}
		</div>
	</div>
</section>

{
  "name": "rejour-parse",
  "version": "0.1.1",
  "description": "Parser for `rejour` that parses the `JATS` document to a `jast` tree.",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "abstract",
    "syntax",
    "tree",
    "jast",
    "jats-xml",
    "rejour"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "rejour-parse",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/xast": "^1.0.2",
    "jast-types": "workspace:^",
    "unified": "^10.1.2",
    "unist-util-filter": "^4.0.1",
    "unist-util-map": "^3.1.3",
    "xast-util-from-xml": "^3.0.0"
  },
  "devDependencies": {
    "unist-util-remove-position": "4.0.2"
  }
}

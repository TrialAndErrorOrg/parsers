{
  "name": "ooxast-util-to-unified-latex",
  "version": "0.6.0",
  "description": "Convert `ooxast` syntax tree to `unified-latex` syntax tree.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/ooxast/ooxast-util-to-unified-latex"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/ooxast/ooxast-util-to-unified-latex#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "word",
    "docx",
    "office",
    "jats",
    "reoff",
    "rejour",
    "latex",
    "unified-latex"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ooxast-util-to-unified-latex",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/xast": "catalog:",
    "@unified-latex/unified-latex-builder": "catalog:",
    "@unified-latex/unified-latex-types": "catalog:",
    "@unified-latex/unified-latex-util-render-info": "catalog:",
    "csl-json": "0.1.0",
    "csl-to-biblatex": "workspace:^",
    "docx-to-vfile": "workspace:^",
    "escape-latex": "1.2.0",
    "ooxast": "workspace:^",
    "ooxast-util-citations": "workspace:^",
    "ooxast-util-get-style": "workspace:^",
    "vfile": "catalog:",
    "xast-util-from-xml": "catalog:",
    "xast-util-is-element": "workspace:^",
    "xast-util-minify-whitespace": "workspace:^",
    "xast-util-select": "workspace:^",
    "xast-util-to-string": "catalog:"
  },
  "devDependencies": {
    "@types/unist": "catalog:",
    "@unified-latex/unified-latex-util-to-string": "catalog:",
    "reoff-cite": "workspace:^",
    "reoff-clean": "workspace:^",
    "reoff-parse": "workspace:^",
    "reoff-parse-references": "workspace:^",
    "unified": "catalog:",
    "unified-latex-stringify": "workspace:^",
    "unist-util-remove-position": "catalog:",
    "xastscript": "catalog:"
  }
}

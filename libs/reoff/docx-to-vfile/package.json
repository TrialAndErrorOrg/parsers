{
  "name": "docx-to-vfile",
  "version": "0.10.0",
  "description": "Reads a `.docx` file and stores its components in vfile format to be processed by other tools, like `reoff-parse`.",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/TrialAndErrorOrg/parsers",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "docx",
    "vfile",
    "ooxast",
    "ooxml",
    "office",
    "word"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "fs": false,
    "stream": false,
    "buffer": false
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "docx-to-vfile",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/xast": "^1.0.2",
    "unzipit": "^2.1.1",
    "vfile": "^5.3.7"
  }
}

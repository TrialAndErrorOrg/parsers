{
  "name": "ooxast-util-to-typast",
  "version": "0.0.0",
  "description": "Convert an `ooxast` (Word document) syntax tree to a `typast` (Typst) syntax tree for the JOTE article template.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/ooxast/ooxast-util-to-typast"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/ooxast/ooxast-util-to-typast#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "word",
    "docx",
    "office",
    "ooxast",
    "reoff",
    "typst",
    "typast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ooxast-util-to-typast",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/xast": "catalog:",
    "csl-json": "0.1.0",
    "csl-to-biblatex": "workspace:^",
    "tex2typst": "^0.6.2",
    "typast": "workspace:^",
    "typast-util-to-typst": "workspace:^",
    "vfile": "catalog:",
    "xast-util-from-xml": "catalog:"
  }
}

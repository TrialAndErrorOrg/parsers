{
  "name": "ojs-api-types",
  "version": "0.0.1",
  "description": "Some typescript types for OJS api responses",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/citations/ojs-types"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/citations/ojs-types#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "ojs",
    "open-journal-systems",
    "pkp",
    "typescript"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ojs-api-types",
    "tsconfig": "./tsconfig.lib.json"
  }
}

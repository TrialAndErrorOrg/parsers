---
import type { Section } from "~/content.config";
import Buttons from "./sections/Buttons.astro";
import Features from "./sections/Features.astro";
import Hero from "./sections/Hero.astro";
import Issues from "./sections/Issues.astro";
import LatestArticles from "./sections/LatestArticles.astro";
import LatestPosts from "./sections/LatestPosts.astro";
import Newsletter from "./sections/Newsletter.astro";
import Team from "./sections/Team.astro";
import Text from "./sections/Text.astro";

interface Props {
	sections: Section[];
}

// To add a section type: make a component in ./sections, add it here,
// and describe its fields in src/content.config.ts and src/admin/config.yml
const components = {
	hero: Hero,
	text: Text,
	features: Features,
	"latest-posts": LatestPosts,
	"latest-articles": LatestArticles,
	issues: Issues,
	team: Team,
	newsletter: Newsletter,
	buttons: Buttons,
} satisfies Record<Section["type"], unknown>;

const { sections } = Astro.props;
---

{
	sections.map((section) => {
		const Component = components[section.type] as any;
		return <Component {...section} />;
	})
}

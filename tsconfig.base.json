{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Resolve workspace packages to their `src` (see the `@jote/source` entry in each
    // package's `exports`), so editors and `tsc --noEmit` see source without building.
    // Library builds (tsconfig.lib.json) reset this to resolve dependencies' built `dist`.
    "customConditions": ["@jote/source"],
    "types": ["node"],
    "strict": true,
    "noImplicitThis": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowUnusedLabels": true,
    "noErrorTruncation": true
  }
}

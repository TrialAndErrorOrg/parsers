{
  "name": "typast-util-from-string",
  "version": "0.0.0",
  "description": "Parse Typst source into a typast syntax tree, with Typst's own parser (typst-syntax)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/typast/typast-util-from-string"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/typast/typast-util-from-string#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unist",
    "typast",
    "typast-util",
    "typst",
    "parse",
    "syntax tree"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#parser": {
      "node": "typast-syntax-node",
      "default": "typast-syntax-wasm"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "typast-util-from-string",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "typast": "workspace:^",
    "typast-syntax-node": "workspace:^",
    "typast-syntax-wasm": "workspace:^"
  },
  "devDependencies": {
    "typast-util-to-typst": "workspace:^"
  }
}

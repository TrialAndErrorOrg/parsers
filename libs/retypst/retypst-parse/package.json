{
  "name": "retypst-parse",
  "version": "0.0.0",
  "description": "retypst plugin (unified parser) that parses Typst source into a typast tree, with Typst's own parser",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/retypst/retypst-parse"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/retypst/retypst-parse#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "unified-plugin",
    "retypst",
    "typast",
    "typst",
    "parse"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "retypst-parse",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "typast": "workspace:^",
    "typast-util-from-string": "workspace:^",
    "unified": "catalog:"
  },
  "devDependencies": {
    "vfile": "catalog:"
  }
}

{
  "name": "docx-to-jats",
  "version": "0.0.0",
  "private": true,
  "description": "processorsDocxToJats(): string;",
  "type": "module",
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "docx-to-jats",
    "tsconfig": "./tsconfig.lib.json"
  }
}

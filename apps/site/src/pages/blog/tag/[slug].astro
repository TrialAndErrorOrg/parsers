---
import type { GetStaticPaths } from "astro";
import BlogList from "~/layouts/BlogList.astro";
import { getTerms } from "~/lib/sources/blog";

export const getStaticPaths = (async () =>
	(await getTerms("tags")).map((term) => ({ params: { slug: term.slug }, props: { term } }))) satisfies GetStaticPaths;

const { term } = Astro.props;
---

<BlogList title={`#${term.title}`} kicker="Tag" posts={term.posts} />

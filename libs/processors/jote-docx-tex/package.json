{
  "name": "jote-docx-tex",
  "version": "0.0.0",
  "private": true,
  "description": "docxToTex(input: Uint8Array, options: object = {}): Promise<VFile>;",
  "type": "module",
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "jote-docx-tex",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "docx-to-vfile": "workspace:^",
    "ooxast-util-citations": "workspace:^",
    "rejour-relatex": "workspace:^",
    "relatex-add-preamble": "workspace:^",
    "relatex-stringify": "workspace:^",
    "reoff-cite": "workspace:^",
    "reoff-clean": "workspace:^",
    "reoff-parse": "workspace:^",
    "reoff-parse-references": "workspace:^",
    "reoff-rejour": "workspace:^",
    "unified": "^10.1.2",
    "vfile": "^5.3.7"
  }
}

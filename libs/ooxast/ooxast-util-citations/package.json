{
  "name": "ooxast-util-citations",
  "version": "0.5.0",
  "description": "This package is [ESM only](https://gist.github.com/sindresorhus/a39789f98801d908bbc7ff3ecc99d99c).",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/ooxast/ooxast-util-citations"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/ooxast/ooxast-util-citations#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "ooxast",
    "docx",
    "ast"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ooxast-util-citations",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/unist": "catalog:",
    "csl-consolidate": "workspace:^",
    "csl-json": "0.1.0",
    "ooxast": "workspace:^",
    "ooxast-util-citation-plugin": "workspace:^",
    "ooxast-util-get-style": "workspace:^",
    "parse-text-cite": "workspace:^",
    "similarity": "^1.2.1",
    "unist-util-visit-parents": "catalog:",
    "vfile": "catalog:",
    "xast-util-is-element": "workspace:^",
    "xast-util-select": "workspace:^",
    "xast-util-to-string": "catalog:",
    "xastscript": "catalog:"
  },
  "devDependencies": {
    "@types/similarity": "^1.2.3"
  }
}

{
  "name": "ooxast-util-to-mdast",
  "version": "0.2.0",
  "description": "Convert `ooxast` syntax tree to `mdast` syntax tree.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrialAndErrorOrg/parsers.git",
    "directory": "libs/ooxast/ooxast-util-to-mdast"
  },
  "homepage": "https://github.com/TrialAndErrorOrg/parsers/tree/main/libs/ooxast/ooxast-util-to-mdast#readme",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "type": "module",
  "keywords": [
    "unified",
    "word",
    "docx",
    "office",
    "jats",
    "reoff",
    "mdast",
    "markdown"
  ],
  "exports": {
    ".": {
      "@jote/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "typedoc": {
    "entryPoint": "./src/index.ts",
    "readmeFile": "./README.md",
    "displayName": "ooxast-util-to-unified-latex",
    "tsconfig": "./tsconfig.lib.json"
  },
  "dependencies": {
    "@types/mdast": "catalog:",
    "@types/unist": "catalog:",
    "@types/xast": "catalog:",
    "csl-json": "0.1.0",
    "docx-to-vfile": "workspace:^",
    "extend": "^3.0.2",
    "mdast-util-math": "catalog:",
    "mdast-util-phrasing": "catalog:",
    "mdast-util-to-string": "catalog:",
    "ooxast": "workspace:^",
    "ooxast-util-citations": "workspace:^",
    "unist-util-position": "catalog:",
    "vfile": "catalog:",
    "xast-util-from-xml": "catalog:",
    "xast-util-is-element": "workspace:^",
    "xast-util-minify-whitespace": "workspace:^",
    "xast-util-select": "workspace:^",
    "xast-util-to-string": "catalog:"
  },
  "devDependencies": {
    "@benrbray/remark-cite": "catalog:",
    "@types/extend": "^3.0.4",
    "remark-gfm": "catalog:",
    "remark-math": "catalog:",
    "remark-stringify": "catalog:",
    "reoff-cite": "workspace:^",
    "reoff-clean": "workspace:^",
    "reoff-parse": "workspace:^",
    "reoff-parse-references": "workspace:^",
    "unified": "catalog:",
    "unist-util-remove-position": "catalog:",
    "xastscript": "catalog:"
  }
}
